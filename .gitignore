# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
out/
release/

# electron-builder buildResources directory (icons / entitlements 等を含むため
# version 管理する)。グローバル ~/.config/git/ignore の "build/" を negate する。
!build/
!build/**

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test files
test-files/

# Playwright
test-results/
playwright-report/
playwright-report-electron/
playwright/.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated (build-time)
src/generated/

# Electron
.electron-builder-cache/

# AI agent / MCP local cache (project ごとにユーザー側で生成されるメタ、commit しない)
.serena/
AGENTS.md

# AI agent の作業用スクラッチ (mutation 用 patch script / 検証ログ / PR 下書き等)。
# sandbox から書ける project 配下の temp 置き場として使うため、project node_modules を
# 参照するワンショット script はここに置かれる。`pnpm up --store-dir` の退避先にもなり
# 数十 MB の pnpm store が生えることがあるので、未 track のまま放置すると
# `git add -A` の誤混入と working tree diff の肥大を招く。
scratchpad/
